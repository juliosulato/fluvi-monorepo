{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!**/*.md", "!src/db/migrations"]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vitest.config*.ts", "drizzle.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/config/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
