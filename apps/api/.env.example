# Read only when NODE_ENV=development (set by the dev and db:* scripts). Deployments pass
# every variable, NODE_ENV included, through the environment.
PORT=3000
DATABASE_URL=postgres://fluvi:fluvi@localhost:5432/fluvi

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API (no /v1/auth suffix)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth "Web application" client. Its ID must match the webClientId used by the app,
# because it is the audience of the ID token sent by the device.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_SCHEME=fluvi://
