{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "suspicious": {
        "noPrototypeBuiltins": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tsup.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
